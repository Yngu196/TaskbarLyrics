{"manifest_version": 3, "name": "Windows任务栏歌词插件", "plugin_id": "Taskbar-Lyrics", "version": "1.0.6", "minversion": "1.6.6", "moekoe": true, "author": {"name": "Yngu196", "url": "https://github.com/Yngu196"}, "description": "在 Windows 任务栏上显示歌词，支持x64，原生arm64处于测试阶段", "permissions": ["storage"], "moekoe_permissions": ["moekoe:nativeHost"], "moekoe_native_hosts": [{"id": "taskbar-lyrics-host", "platforms": {"win32": {"path": "MoeKoeTaskbarLyrics.exe", "args": []}}, "auto_start": true, "bridge": "native-bridge.html"}], "background": {"service_worker": "background.js"}, "content_scripts": [{"matches": ["*://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_title": "任务栏歌词设置", "default_icon": {"256": "icons/icon256.png"}}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://127.0.0.1/*"]}], "icons": {"256": "icons/icon256.png"}}